# Copy to .env.prod and fill in real values before deploying.
# See README.md "Deploy to a live server" for the full walkthrough.

# Strong random password for the Postgres role used in production.
# Generate one with: openssl rand -base64 24
POSTGRES_PASSWORD=

# Long random secret used to sign JWTs. Generate one with:
# openssl rand -base64 48
JWT_SECRET=

# Origin the API accepts CORS requests from. Once you have a domain, this
# should be https://yourdomain.com — until then it can be left as the
# server's bare IP (http://SERVER_IP).
WEB_ORIGIN=http://localhost

# Caddy site address. Leave as :80 to serve plain HTTP on the server's bare
# IP (no domain yet). Once a domain's DNS A record points at this server,
# set this to the domain and Caddy will automatically obtain and renew a
# Let's Encrypt HTTPS certificate for it — no other change needed.
DOMAIN=:80
